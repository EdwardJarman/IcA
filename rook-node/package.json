{
  "name": "@rook/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rook Node sidecar: supervised local Chromium, Bot tab registry, control gateway, durable local state. Phase 1 — Local computer core.",
  "main": "dist/index.js",
  "bin": {
    "rook-node": "dist/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
